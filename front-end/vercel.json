{
  "rewrites": [
    {
      "source": "/firebase-config-and-csrf-token",
      "destination": "https://moonlit-ai-agent.onrender.com/firebase-config-and-csrf-token"
    },
    {
      "source": "/set_authenticated_user_session",
      "destination": "https://moonlit-ai-agent.onrender.com/set_authenticated_user_session"
    },
    {
      "source": "/check_authenticated_user_session",
      "destination": "https://moonlit-ai-agent.onrender.com/check_authenticated_user_session"
    },
    {
      "source": "/logout_authenticated_user_session",
      "destination": "https://moonlit-ai-agent.onrender.com/logout_authenticated_user_session"
    },
    { "source": "/api/:path*", "destination": "https://moonlit-ai-agent.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
